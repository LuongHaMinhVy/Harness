GOOGLE_GENERATIVE_AI_API_KEY=
MODEL=gemini-2.5-flash
MAX_STEPS=6
# Dự phòng (tuỳ chọn): Gemini bị giới hạn/hết quota ngày thì lượt đó chuyển sang Groq. Key miễn phí: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Web lớp học (tuỳ chọn)
PORT=3000
# Mở cho mạng LAN: pnpm web:lan; thêm tên máy khác (cách nhau bằng dấu phẩy):
ALLOWED_HOSTS=
# Bật HTTPS (nên bật khi mở LAN) — đường dẫn file chứng chỉ, vd. tạo bằng mkcert:
TLS_CERT=
TLS_KEY=
# Token GitHub (tuỳ chọn) để tăng giới hạn số lần tải repo public:
GITHUB_TOKEN=
# Admin đầu tiên, tạo khi chạy `pnpm seed:demo` (email là tên đăng nhập; mật khẩu ≥ 8 ký tự, không bắt đổi).
# Đã có tài khoản này thì không ghi đè mật khẩu. Tạo xong nên xoá ADMIN_PASSWORD khỏi .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
