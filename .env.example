GOOGLE_GENERATIVE_AI_API_KEY=
MODEL=gemini-2.5-flash
MAX_STEPS=6
# Web lớp học (tuỳ chọn)
PORT=3000
# Mở cho mạng LAN: pnpm web:lan; thêm tên máy khác (cách nhau bằng dấu phẩy):
ALLOWED_HOSTS=
# Bật HTTPS (nên bật khi mở LAN) — đường dẫn file chứng chỉ, vd. tạo bằng mkcert:
TLS_CERT=
TLS_KEY=
# Token GitHub (tuỳ chọn) để tăng giới hạn số lần tải repo public:
GITHUB_TOKEN=
