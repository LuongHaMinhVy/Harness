{
  "name": "harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Harness chấm bài lập trình JavaScript",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx apps/cli/src/cli.ts",
    "eval": "tsx apps/cli/src/eval.ts",
    "spike": "tsx apps/cli/src/spike.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p packages/core && tsc -p apps/cli && tsc -p apps/server && tsc -p apps/web",
    "web:build": "pnpm --filter @harness/web build",
    "web": "pnpm web:build && tsx apps/server/src/main.ts",
    "web:mock": "pnpm web:build && tsx apps/server/src/mock/main.ts",
    "web:api": "tsx watch apps/server/src/main.ts --dev",
    "web:ui": "pnpm --filter @harness/web dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
